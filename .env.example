# Copia este archivo como .env y llena los valores.

# Base de datos
DB_NAME=Edu-verseDB
DB_PASSWORD=postgres

# Autenticación
JWT_SECRET=cambia_esto_por_un_secreto_largo

# Tutor IA (Groq) — https://console.groq.com/keys
# La API key solo la usa el backend; nunca va en el frontend.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_RESPALDO=openai/gpt-oss-20b
TUTOR_LIMITE_POR_MINUTO=10
