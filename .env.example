# Copia este archivo a .env en la raíz. Docker Compose lo usa para los tres
# servicios. No lo subas al repositorio.
DB_PASSWORD=postgres
DB_NAME=Edu-verseDB
JWT_SECRET=

# Puertos publicados en el host.
BACKEND_PORT=4001
FRONTEND_PORT=8080

# Cuota total de apuntes por usuario, en MB.
UPLOAD_QUOTA_MB=100

# Si el frontend se sirve detrás de Nginx en el mismo origen, déjalo vacío.
VITE_API_URL=
