# Copia este archivo a .env y completa los valores.
# Genera JWT_SECRET con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DB_USER=postgres
DB_HOST=localhost
DB_NAME=Edu-verseDB
DB_PASSWORD=postgres
DB_PORT=5432
PORT=4000
JWT_SECRET=
# Cuota total de apuntes por usuario, en MB (por defecto 100).
UPLOAD_QUOTA_MB=100

# Tutor IA (Groq) — https://console.groq.com/keys
# La API key solo la usa el backend; nunca va en el frontend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_RESPALDO=openai/gpt-oss-20b
TUTOR_LIMITE_POR_MINUTO=10
